+// Use the same transformed bounding rectangles as PDF link annotations.
+fn collect_preview_links(
+    frame: &::typst::layout::Frame,
+    transform: ::typst::layout::Transform,
+    doc: &TypstPagedDocument,
+    links: &mut Vec<serde_json::Value>,
+) {
+    use ::typst::layout::{FrameItem, Point, Transform};
+    use ::typst::model::Destination;
+
+    for (position, item) in frame.items() {
+        let transform = transform.pre_concat(Transform::translate(position.x, position.y));
+        match item {
+            FrameItem::Group(group) => collect_preview_links(
+                &group.frame, transform.pre_concat(group.transform), doc, links,
+            ),
+            FrameItem::Link(destination, size) => {
+                let corners = [Point::zero(), Point::with_x(size.x),
+                    Point::with_y(size.y), size.to_point()];
+                let corners = corners.map(|p| p.transform(transform));
+                let x = corners.iter().map(|p| p.x.to_pt()).fold(f64::INFINITY, f64::min);
+                let y = corners.iter().map(|p| p.y.to_pt()).fold(f64::INFINITY, f64::min);
+                let right = corners.iter().map(|p| p.x.to_pt()).fold(f64::NEG_INFINITY, f64::max);
+                let bottom = corners.iter().map(|p| p.y.to_pt()).fold(f64::NEG_INFINITY, f64::max);
+                let width = right - x;
+                let height = bottom - y;
+                if ![x, y, width, height].iter().all(|v| v.is_finite()) || width <= 0.0 || height <= 0.0 {
+                    continue;
+                }
+                let mut link = serde_json::json!({"x": x, "y": y, "width": width, "height": height});
+                match destination {
+                    Destination::Url(url) => link["url"] = serde_json::json!(url.as_str()),
+                    _ => {
+                        let position = match destination {
+                            Destination::Position(position) => Some(*position),
+                            Destination::Location(location) => doc.introspector().position(*location),
+                            _ => None,
+                        };
+                        let Some(position) = position else { continue; };
+                        link["page"] = serde_json::json!(position.page.get());
+                        link["targetX"] = serde_json::json!(position.point.x.to_pt());
+                        link["targetY"] = serde_json::json!(position.point.y.to_pt());
+                    }
+                }
+                links.push(link);
+            }
+            _ => {}
+        }
+    }
+}
+
+fn collect_preview_text(
+    frame: &::typst::layout::Frame,
+    world: &dyn ::typst::World,
+    origin: ::typst::layout::Point,
+    positioned: bool,
+    text: &mut Vec<serde_json::Value>,
+    plain_text: &mut Vec<String>,
+) {
+    use ::typst::layout::{FrameItem, Point};
+
+    for (position, item) in frame.items() {
+        let position = origin + *position;
+        match item {
+            FrameItem::Text(run) => {
+                if run.text.is_empty() {
+                    continue;
+                }
+                plain_text.push(run.text.to_string());
+                if !positioned {
+                    continue;
+                }
+                // A shaped line can combine authored wording and generated fields.
+                // Keep the existing glyph geometry, splitting only at source spans.
+                let line_bounds = run.bbox();
+                let mut start = 0;
+                let mut offset = ::typst::layout::Abs::zero();
+                while start < run.glyphs.len() {
+                    let span = run.glyphs[start].span.0;
+                    let mut end = start + 1;
+                    while end < run.glyphs.len() && run.glyphs[end].span.0 == span { end += 1; }
+                    let glyphs = &run.glyphs[start..end];
+                    let from = glyphs.iter().map(|g| g.range().start).min().unwrap();
+                    let to = glyphs.iter().map(|g| g.range().end).max().unwrap();
+                    let mut part = run.clone();
+                    part.text = run.text.get(from..to).unwrap_or_default().into();
+                    part.glyphs = glyphs.to_vec();
+                    let bounds = part.bbox();
+                    let x0 = (position.x + offset + bounds.min.x).to_pt();
+                    let x1 = (position.x + offset + bounds.max.x).to_pt();
+                    let y0 = (position.y + line_bounds.min.y).to_pt();
+                    let y1 = (position.y + line_bounds.max.y).to_pt();
+                    let origin = span.id().and_then(|id| {
+                        let source = world.source(id).ok()?;
+                        let node = source.find(span)?;
+                        Some(serde_json::json!({"path": id.vpath().get_without_slash(),
+                            "from": node.range().start, "to": node.range().end}))
+                    });
+                    let width = (x1 - x0).abs();
+                    let height = (y1 - y0).abs();
+                    if x0.is_finite() && y0.is_finite() && width > 0.0 && height > 0.0 {
+                        text.push(serde_json::json!({
+                            "text": part.text.as_str(), "x": x0.min(x1), "y": y0.min(y1),
+                            "width": width, "height": height, "origin": origin,
+                            "fontSize": run.size.to_pt(),
+                        }));
+                    }
+                    offset += glyphs.iter().map(|g| g.x_advance.at(run.size)).sum();
+                    start = end;
+                }
+            }
+            FrameItem::Group(group) => {
+                let movable = group.transform.is_only_translate();
+                let offset = Point::new(group.transform.tx, group.transform.ty);
+                collect_preview_text(
+                    &group.frame,
+                    world,
+                    position + offset,
+                    positioned && movable,
+                    text,
+                    plain_text,
+                );
+            }
+            _ => {}
+        }
+    }
+}
