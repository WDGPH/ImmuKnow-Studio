{
  "name": "immuknow-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/check-dev-assets.mjs && npm run prepare:assets && node scripts/prepare-contracts.mjs",
    "dev": "vite",
    "serve": "vite preview --host 0.0.0.0 --port 4173",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:browser": "uv run --locked --group browser playwright test",
    "test:unit": "vitest run",
    "lint": "biome lint src tests unit",
    "generate:contracts": "node scripts/prepare-contracts.mjs",
    "prebuild": "npm run prepare:assets && node scripts/prepare-contracts.mjs",
    "pretest:unit": "node scripts/prepare-contracts.mjs",
    "pretypecheck": "node scripts/prepare-contracts.mjs",
    "prepare:assets": "uv run --locked python -m scripts.prepare_assets",
    "prepare:runtimes": "uv run --locked python -m scripts.prepare_runtimes prepare",
    "build:site": "uv run --locked python -m scripts.build-site"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "codemirror": "6.0.2",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
